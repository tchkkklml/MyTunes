<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="950.0" prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: grey;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.MainController">
   <top>
      <HBox alignment="CENTER" prefHeight="110.0" prefWidth="950.0" spacing="15.0" style="-fx-background-color: lightgrey;" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#onClickBtnPrevious" prefHeight="25.0" prefWidth="35.0" style="-fx-background-radius: 7;" text="⏮" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="14.0" />
               </font>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Button>
            <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#onClickBtnPlay" prefHeight="30.0" prefWidth="45.0" style="-fx-background-radius: 7;" text="▶" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onClickBtnNext" prefHeight="25.0" prefWidth="35.0" style="-fx-background-radius: 7;" text="⏭" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Separator orientation="VERTICAL" prefHeight="80.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
            <VBox prefHeight="80.0" prefWidth="137.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblCurrentSongTitle" prefHeight="34.0" prefWidth="175.0" text="No song selected" VBox.vgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblCurrentSongArtist" prefHeight="34.0" prefWidth="154.0" text="Artist" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <Label fx:id="lblTimePast" text="0:00" HBox.hgrow="ALWAYS" />
            <Slider fx:id="sldrSong" blockIncrement="5.0" onMouseReleased="#onSldrSong" prefHeight="16.0" prefWidth="150.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="lblTimeFull" text="0:00" HBox.hgrow="ALWAYS" />
            <Separator orientation="VERTICAL" prefHeight="80.0" prefWidth="24.0" HBox.hgrow="ALWAYS" />
            <Slider fx:id="sldrVolume" blockIncrement="5.0" minorTickCount="1" onMouseReleased="#onSldrVolume" orientation="VERTICAL" value="70.0" HBox.hgrow="ALWAYS" />
            <Separator orientation="VERTICAL" prefHeight="80.0" prefWidth="31.0" />
            <TextField fx:id="txtFilter" promptText="Filter by title or artist..." />
            <Button mnemonicParsing="false" onAction="#onClickBtnFilter" text="Filter" />
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <BorderPane.margin>
            <Insets bottom="15.0" />
         </BorderPane.margin>
      </HBox>
   </top>
   <center>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="3.0" left="10.0" right="10.0" />
         </padding>
         <children>
            <VBox prefHeight="490.0" prefWidth="270.0" style="-fx-background-color: lightgrey; -fx-background-radius: 7;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="PLAYLISTS" VBox.vgrow="ALWAYS">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="5.0" left="10.0" top="5.0" />
                     </VBox.margin>
                     <padding>
                        <Insets left="5.0" top="5.0" />
                     </padding>
                  </Label>
                  <TableView fx:id="allPaylists" cache="true" style="-fx-background-color: lightgrey;" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn prefWidth="75.0" text="Name" />
                      <TableColumn prefWidth="108.76858520507812" text="Somgs" />
                        <TableColumn prefWidth="59.23143005371094" text="Time" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <Separator prefWidth="200.0" VBox.vgrow="ALWAYS" />
                  <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="35.0" spacing="5.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onClickBtnPlaylistsNew" text="New..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onClickBtnPlaylistsEdit" text="Edit..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onClickBtnPlaylistsDelete" text="Delete" textFill="RED" HBox.hgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
            <VBox prefHeight="475.0" prefWidth="273.0" style="-fx-background-color: lightgrey; -fx-background-radius: 7;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="PLAYLIST IS NOT SELECTED" VBox.vgrow="ALWAYS">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <padding>
                        <Insets left="5.0" top="5.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="5.0" left="10.0" top="5.0" />
                     </VBox.margin>
                  </Label>
                  <ListView fx:id="selectedPlaylist" style="-fx-background-color: lightgrey;" VBox.vgrow="ALWAYS" />
                  <Separator prefWidth="200.0" VBox.vgrow="ALWAYS" />
                  <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="35.0" spacing="5.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onClickBtnUp" text="↑" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onClickBtnDown" text="↓" HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets right="10.0" />
                           </HBox.margin>
                        </Button>
                        <Region prefHeight="35.0" prefWidth="81.0" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onClickBtnSelectedPDelete" text="Delete" textFill="RED" HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets left="10.0" right="5.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#onClickBtnTransfer" prefHeight="30.0" prefWidth="50.0" style="-fx-background-radius: 7;" text="←" />
            <VBox prefHeight="472.0" prefWidth="375.0" style="-fx-background-color: lightgrey; -fx-background-radius: 7;" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" maxHeight="0.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label prefHeight="28.0" prefWidth="203.0" text="ALL SONGS" HBox.hgrow="ALWAYS">
                           <font>
                              <Font size="18.0" />
                           </font>
                           <padding>
                              <Insets left="5.0" top="5.0" />
                           </padding>
                           <HBox.margin>
                              <Insets bottom="5.0" left="10.0" top="5.0" />
                           </HBox.margin>
                        </Label>
                        <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSongCount" alignment="CENTER_RIGHT" minWidth="-Infinity" prefHeight="28.0" prefWidth="100.0" text="0 songs" HBox.hgrow="ALWAYS">
                           <font>
                              <Font size="18.0" />
                           </font>
                           <opaqueInsets>
                              <Insets />
                           </opaqueInsets>
                           <HBox.margin>
                              <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                           </HBox.margin>
                           <padding>
                              <Insets top="5.0" />
                           </padding>
                        </Label>
                     </children>
                  </HBox>
                  <TableView fx:id="AllSongsList" cache="true" style="-fx-background-color: lightgrey;" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn prefWidth="75.0" text="Title" />
                        <TableColumn prefWidth="108.76858520507812" text="Artist" />
                        <TableColumn prefWidth="59.23143005371094" text="Category" />
                        <TableColumn prefWidth="59.23143005371094" text="Time" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <Separator prefHeight="0.0" prefWidth="404.0" VBox.vgrow="ALWAYS" />
                  <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="35.0" prefWidth="404.0" spacing="5.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onClickBtnAllSongsNew" text="New..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onClickBtnAllSongsEdit" text="Edit..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onClickBtnAllSongsDelete" text="Delete" textFill="RED" HBox.hgrow="ALWAYS" />
                     </children>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
